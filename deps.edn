{:deps    {edd/edd-web-primitives    {:local/root "modules/edd-web-primitives"}
           metosin/malli             {:mvn/version "0.20.2"}
           org.clojure/clojure       {:mvn/version "1.12.6"}
           org.clojure/clojurescript {:mvn/version "1.12.145"}
           org.clojure/core.async    {:mvn/version "1.9.865"}
           cljs-ajax/cljs-ajax       {:mvn/version "0.8.4"}
           re-frame/re-frame         {:mvn/version "1.4.7"}
           reagent/reagent           {:mvn/version "2.0.1"}
           metosin/reitit-frontend   {:mvn/version "0.11.0"}}
 :paths   ["src" "resources" "modules/src" "template"],
 :aliases {:jar {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
                 :ns-default build},
           :shadow-cljs  {:main-opts ["-m" "shadow.cljs.devtools.cli"]
                          :extra-deps
                          {thheller/shadow-cljs {:mvn/version "3.5.3"}}}
           :dev      {:extra-paths ["test/clj" "test/cljs"]
                      :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}}}
           :test     {:extra-paths ["test/clj" "test/cljs"],
                      :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}}},
           :unit     {:extra-paths ["test/clj" "test/cljs"]
                      :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}},
                      :main-opts   ["-m" "kaocha.runner", "unit"]}
           :it       {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}},
                      :main-opts  ["-m" "kaocha.runner", "it"]}
           :readme   {:extra-paths ["target/src"]
                      :extra-deps  {alpha-prosoft/readme {:mvn/version "1.7"}}
                      :main-opts   ["-m" "seancorfield.readme"]}
           :zip {:main-opts ["-m" "edd.bootstrap" "package-project"]}}}
