{:paths ["src"]
 :deps  {edd/edd-core-web                     {:local/root "../../"}
         edd/edd-web-primitives               {:local/root "../edd-web-primitives"}
         cljs-ajax/cljs-ajax                  {:mvn/version "0.8.4"}
         com.andrewmcveigh/cljs-time          {:mvn/version "0.5.2"}}
 :aliases
 {:lint
  {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2025.04.07"}}
   :main-opts  ["-m" "clj-kondo.main" "--lint src/main"]}

  :dev
  {:extra-paths ["src/test/clj" "src/test/cljs" "src/test/resources"]
   :extra-deps  {binaryage/devtools                   {:mvn/version "1.0.7"}
                 thheller/shadow-cljs                 {:mvn/version "3.5.3"}}}

  :gallery
  {:extra-paths ["gallery"]}

  ;; Integration tests against the widgets gallery, on the primitives gallery helpers and SDK.
  :it
  {:replace-paths ["src/it"
                   "../edd-web-primitives/src/it"
                   "../edd-web-primitives/src/sdk"
                   "../edd-web-primitives/src/shared"]
   :replace-deps  {org.clojure/clojure                  {:mvn/version "1.12.6"}
                   com.microsoft.playwright/playwright  {:mvn/version "1.64.0"}
                   com.alpha-prosoft/clojure-playwright {:mvn/version "1.3"}
                   lambdaisland/kaocha                  {:mvn/version "1.91.1392"}}
   :main-opts     ["-m" "kaocha.runner" "--config-file" "tests-it.edn"]}

  :shadow-cljs
  {:main-opts ["-m" "shadow.cljs.devtools.cli"]
   :extra-deps
   {thheller/shadow-cljs {:mvn/version "3.5.3"}}}

  :cider-cljs
  {:extra-deps {cider/cider-nrepl {:mvn/version "0.55.7"}
                cider/piggieback {:mvn/version "0.6.0"}}}
  :test
  {:extra-paths ["src/test/clj" "src/test/resources"]
   :extra-deps  {day8.re-frame/test                   {:mvn/version "0.1.5"}
                 org.clojure/test.check {:mvn/version "1.1.1"}}}

  :runner
  {:extra-deps {lambdaisland/kaocha #:mvn {:mvn/version "1.91.1392"}}
   :main-opts  ["-m" "kaocha.runner"]}

  :jar
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}}
   :ns-default build}}}
