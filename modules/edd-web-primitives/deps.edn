{:paths ["src/main" "src/shared"]
 :deps  {org.clojure/clojure         {:mvn/version "1.12.6"}
         reagent/reagent             {:mvn/version "2.0.1"}
         re-frame/re-frame           {:mvn/version "1.4.7"}
         org.clojure/clojurescript   {:mvn/version "1.12.145"}
         thheller/shadow-cljs        {:mvn/version "3.5.3"}
         com.andrewmcveigh/cljs-time {:mvn/version "0.5.2"}
         binaryage/devtools          {:mvn/version "1.0.7"}
         org.slf4j/slf4j-simple      {:mvn/version "2.0.20"}}

 :aliases
        {:lint
         {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
          :main-opts  ["-m" "clj-kondo.main" "--lint" "src/main"]}
         :dev
         {:extra-paths ["src/test/clj" "src/test/cljs" "src/test/resources"]
          :extra-deps {day8.re-frame/re-frame-10x  {:mvn/version "1.12.3"}
                       day8.re-frame/tracing       {:mvn/version "0.9.2"}}}
         :gallery
         {:extra-paths ["src/gallery"]}

         ;; UI test SDK: Clojure/JVM only, no ClojureScript toolchain.
         ;; This is exactly what the ui-sdk artifact ships.
         :sdk
         {:replace-paths ["src/sdk" "src/shared"]
          :replace-deps  {org.clojure/clojure                 {:mvn/version "1.12.6"}
                          com.microsoft.playwright/playwright {:mvn/version "1.64.0"}}}

         ;; Integration tests against the gallery: SDK + clojure-playwright runner.
         :it
         {:replace-paths ["src/it" "src/sdk" "src/shared"]
          :replace-deps  {org.clojure/clojure                  {:mvn/version "1.12.6"}
                          com.microsoft.playwright/playwright  {:mvn/version "1.64.0"}
                          com.alpha-prosoft/clojure-playwright {:mvn/version "1.3"}
                          lambdaisland/kaocha                  {:mvn/version "1.91.1392"}}
          :main-opts     ["-m" "kaocha.runner" "--config-file" "tests-it.edn"]}

         ;; Local only: HTML report of the last IT run (target/pw-traces/index.html)
         ;; and an HTTP server so its trace-viewer links work.
         :it-report
         {:replace-deps {com.alpha-prosoft/clojure-playwright {:mvn/version "1.3"}}
          :main-opts    ["-m" "testing.pw-aggregate"]}

         :it-traces
         {:replace-deps {com.alpha-prosoft/clojure-playwright {:mvn/version "1.3"}}
          :main-opts    ["-m" "testing.pw-http-server"]}

         :build
         {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                       org.clojure/clojure           {:mvn/version "1.12.6"}}
          :ns-default build}

         :test
         {:extra-paths ["src/test/clj" "src/test/cljs" "src/test/resources"]
          :extra-deps  {org.clojure/clojure    {:mvn/version "1.12.6"}
                        org.clojure/test.check {:mvn/version "1.1.3"}}}
         :runner
         {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
          :main-opts  ["-m" "kaocha.runner"]}
         :prod
         {:extra-deps
          {day8.re-frame/tracing-stubs {:mvn/version "0.9.2"}}}
         :antiq {:deps {com.github.liquidz/antq {:mvn/version "RELEASE"}}
                 :main-opts ["-m" "antq.core"]}}}
