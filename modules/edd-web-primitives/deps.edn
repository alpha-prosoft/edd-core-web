{:paths ["src/main"]
 :deps  {org.clojure/clojure         {:mvn/version "1.11.1"}
         reagent/reagent             {:mvn/version "1.2.0"}
         re-frame/re-frame           {:mvn/version "1.4.3"}
         org.clojure/clojurescript   {:mvn/version "1.11.60"}
         thheller/shadow-cljs        {:mvn/version "2.28.20"}
         com.andrewmcveigh/cljs-time {:mvn/version "0.5.2"}
         binaryage/devtools          {:mvn/version "1.0.7"}
         org.slf4j/slf4j-simple      {:mvn/version "2.0.16"}}

 :aliases
        {:lint
         {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2025.01.16"}}
          :main-opts  ["-m" "clj-kondo.main" "--lint" "src/main"]}
         :dev
         {:extra-paths ["src/test/clj" "src/test/cljs" "src/test/resources" "src/devcards"]
          :extra-deps {day8.re-frame/re-frame-10x  {:mvn/version "1.9.10"}
                       day8.re-frame/tracing       {:mvn/version "0.6.2"}
                       devcards/devcards {:mvn/version "0.2.7"
                                          :exclusions [cljsjs/react-dom
                                                       cljsjs/react
                                                       cljsjs/react-dom-server]}}}
         :test
         {:extra-paths ["src/test/clj" "src/test/cljs" "src/test/resources"]
          :extra-deps  {org.clojure/clojure    {:mvn/version "1.10.2-alpha1"}
                        org.clojure/test.check {:mvn/version "1.1.1"}}}
         :runner
         {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
          :main-opts  ["-m" "kaocha.runner"]}
         :prod
         {:extra-deps
          {day8.re-frame/tracing-stubs {:mvn/version "0.6.2"}}}
         :antiq {:deps {com.github.liquidz/antq {:mvn/version "RELEASE"}}
                 :main-opts ["-m" "antq.core"]}}}
