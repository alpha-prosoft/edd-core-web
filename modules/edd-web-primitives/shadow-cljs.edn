{:deps   true
 :nrepl  {:port 3334}
 :builds
 {:test
  {:target    :karma
   :output-to "target/ci.js"
   :autorun   true}

  :gallery
  {:target     :browser
   :output-dir "resources/gallery/js"
   :asset-path "/js"
   :modules    {:main {:entries  [web.gallery.main]
                       :init-fn web.gallery.main/init}}
   :js-options
   {:npm-module {:transpile ["suneditor"]}}
   :compiler-options
   {:infer-externs    :auto
    :closure-warnings {:global-this :off}}
   :devtools
   {:http-port        3002
    :http-root        "resources/gallery"
    :http-handler     shadow.http.push-state/handle
    :push-state/index "index.html"
    :preloads         [devtools.preload]}
   :release
   {:compiler-options {:infer-externs :auto
                       :optimizations :advanced}}}}}


