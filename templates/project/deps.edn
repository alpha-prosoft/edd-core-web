{:paths   ["src"
           "test"]
 :deps    {edd/edd-core-web    {:local/root "../../"}
           edd/edd-web-primitives {:local/root "../../modules/edd-web-primitives"}
           edd/edd-web-widgets {:local/root "../../modules/edd-web-widgets"}
           metosin/malli {:mvn/version "0.20.3"}}
 
 :aliases {:dev
           {:extra-deps {day8.re-frame/re-frame-10x {:mvn/version "1.12.3"}
                         proto-repl/proto-repl      {:mvn/version "0.3.1"}
                         day8.re-frame/test         {:mvn/version "0.1.7"}
                         day8.re-frame/tracing      {:mvn/version "0.9.2"}
                         binaryage/devtools         {:mvn/version "1.0.7"}}}
           :local-dev {:extra-paths ["script",
                                     "../../src"
                                     "../../modules/edd-web-widgets/src/main"]}
           :cider-cljs 
           {:extra-deps {cider/cider-nrepl {:mvn/version "0.63.1"}
                                     cider/piggieback {:mvn/version "0.8.0"}}}
           :it {:extra-paths ["test/it"]
                :extra-deps {edd/edd-web-primitives-ui-sdk {:local/root "../../modules/edd-web-primitives"}
                             edd/edd-core-web-playwright {:local/root "../../modules/edd-core-web-playwright"}
                             lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                :main-opts ["-m" "kaocha.runner" "--config-file" "tests-it.edn"]}
           :guide {:extra-paths ["test/it" "test/guide"]
                   :extra-deps {edd/edd-web-primitives-ui-sdk {:local/root "../../modules/edd-web-primitives"}
                                edd/edd-core-web-playwright {:local/root "../../modules/edd-core-web-playwright"}}
                   :main-opts ["-m" "projectname.guide"]}
           :explore {:extra-paths ["test/it" "test/explore"]
                     :extra-deps {edd/edd-web-primitives-ui-sdk {:local/root "../../modules/edd-web-primitives"}
                                  edd/edd-core-web-playwright {:local/root "../../modules/edd-core-web-playwright"}}
                     :main-opts ["-m" "testing.repl" "7888" "projectname.explore"]}
           :headed {:jvm-opts ["-Dplaywright.browser.headless=false"]}
           :run {:main-opts ["-m" "edd.dev"]}
           :clean {:exec-fn edd.dev/clean}
           :format {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
                    :main-opts ["-m" "cljfmt.main"]}
           :shadow-cljs
           {:main-opts ["-m" "shadow.cljs.devtools.cli"]
            :extra-deps {thheller/shadow-cljs {:mvn/version "3.5.8"}}}}}
